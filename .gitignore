cat << 'EOF' > .gitignore
# Python & Jupyter
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/

# Environment & Secrets
.env
*.key
*.pem

# Large Data & Local Logs (Keep processed sheets, ignore massive raw dumps)
data/raw/*
!data/raw/.gitkeep
*.log
*.sqlite3

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF
